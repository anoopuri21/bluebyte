{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluebyte",
  // Handles POST /api/contact (the old contactform.php endpoint). Every other
  // request is forwarded to the static assets via the ASSETS binding.
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  // Non-secret defaults only. Secrets (RESEND_API_KEY / WEB3FORMS_ACCESS_KEY /
  // CONTACT_WEBHOOK_URL) are set with `wrangler secret put <NAME>`.
  "vars": {
    "MAIL_TO": "info@bluebyteitinfosystem.com,websitesexperts@gmail.com",
    "FROM_EMAIL": "no-reply@bluebyteitinfosystem.com",
    "SUBJECT_PREFIX": "Contact Form - Bluebyte IT Solutions"
  },
  "assets": {
    // Static output directory produced by the build command below.
    // Do not point this at the repository root: wrangler writes its own
    // `.wrangler/` temp files there, which makes `wrangler dev` reload forever.
    "directory": "./dist",
    // Exposes the asset collection to src/worker.js as env.ASSETS.
    "binding": "ASSETS",
    // /about.html -> /about, /about -> serves about.html, / -> serves index.html
    "html_handling": "auto-trailing-slash",
    // Serve 404.html for unmatched routes.
    "not_found_handling": "404-page",
    // Required for the contact form. compatibility_date >= 2025-04-01 plus
    // not_found_handling: "404-page" makes browser *navigation* requests skip
    // the Worker and hit the asset layer. An HTML form POST is a navigation
    // request (Sec-Fetch-Mode: navigate), and static assets only allow GET/HEAD,
    // so POST /api/contact was returning 405 Method Not Allowed and never
    // reaching src/worker.js. /api/* already covers /api/contact; keep only
    // that wildcard plus the legacy PHP alias (overlapping routes are invalid).
    // Restricting this to the form paths keeps CSS, images and HTML off the bill.
    "run_worker_first": ["/api/*", "/contactform.php"]
  },
  // Wrangler runs this before every `wrangler deploy` (and `wrangler dev`),
  // so a plain `npx wrangler deploy` - with no separate build command
  // configured in Cloudflare Workers Builds - still produces ./dist.
  "build": {
    "command": "node scripts/build-dist.mjs"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
